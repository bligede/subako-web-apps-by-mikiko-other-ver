# Salin ke .env lalu ganti nilainya. Jangan commit .env.
# Password database hanya untuk lingkungan pengembangan.
POSTGRES_PASSWORD=subako_dev_only

# Wajib: string acak minimal 32 karakter. Buat dengan:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SUBAKO_JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Origin frontend (compose memakai http://localhost:8080)
SUBAKO_CORS_ORIGINS=http://localhost:8080
