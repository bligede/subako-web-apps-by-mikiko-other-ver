# Jalankan dari folder backend: cp .env.example .env
SUBAKO_ENV=development
SUBAKO_DATABASE_URL=sqlite:///./subako.db
SUBAKO_JWT_SECRET=dev-only-change-me
SUBAKO_ACCESS_TTL_S=1800
SUBAKO_REFRESH_TTL_S=604800
SUBAKO_SIMULATION_ENABLED=true
SUBAKO_SIMULATION_INTERVAL_S=5
SUBAKO_SEED_DEMO=true
SUBAKO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
